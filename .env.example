# Agora Credentials
AGORA_APP_ID=
AGORA_APP_CERT=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Agora RTC Tokens (optional - for testing only, generate dynamically in production)
AGORA_RTC_TOKEN_INT_UID=
AGORA_RTC_TOKEN_USER_ACCOUNT=

# Agora Chat Configuration
AGORA_CHAT_REST_API=a61.chat.agora.io
AGORA_CHAT_WEBSOCKET=mysync-api-61.chat.agora.io

# Gemini LLM Configuration
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-pro

# Application Settings
LOGS_DIR=logs
DATA_CSV=Indian-Food-Data.csv

# Optional: override Agora Conversational AI REST base URL (useful for region-specific endpoints)
# AGORA_API_BASE=https://api.agora.io/api/conversational-ai-agent/v2

# IMPORTANT: keep your App Certificate and Customer Secret safe. Do NOT commit real credentials to git.